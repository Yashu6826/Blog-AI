# Create a local .env from this file and add your own values.
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace_with_admin_password
MONGODB_URI=replace_with_mongodb_connection_string

IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=poolside/laguna-xs-2.1:free
OPENROUTER_MAX_TOKENS=1800

# Optional: shown to OpenRouter as your app's referer.
APP_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
